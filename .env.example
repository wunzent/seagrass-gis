# Demo-only local Docker configuration. Do not reuse these credentials externally.
POSTGRES_DB=gis
POSTGRES_USER=gis
POSTGRES_PASSWORD=gis-local-demo-only
DB_PORT=54329
API_PORT=3001
WEB_PORT=3000

# Bare local API development (Docker service uses hostname db instead).
DATABASE_URL=postgresql://gis:gis-local-demo-only@localhost:54329/gis
PORT=3001
