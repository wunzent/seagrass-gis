# Demo-only local Docker configuration. Do not reuse these credentials externally.
POSTGRES_DB=gis
POSTGRES_USER=gis
POSTGRES_PASSWORD=gis-local-demo-only
DB_PORT=54329
API_PORT=3001
WEB_PORT=3000
TILES_PORT=3002
# Auth (demo-only). JWT_SECRET must be >=32 bytes; demo passwords seed viewer/editor/admin@demo.local at API startup.
JWT_SECRET=local-demo-only-jwt-secret-not-for-production
DEMO_VIEWER_PASSWORD=viewer-demo-only
DEMO_EDITOR_PASSWORD=editor-demo-only
DEMO_ADMIN_PASSWORD=admin-demo-only
