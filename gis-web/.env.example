# ค่าสำหรับ host development เท่านั้น (demo-only; ไม่มี secret)
PORT=3003
NEXT_TELEMETRY_DISABLED=1
# Origin ภายในของ API ที่ proxy /api/* ส่งต่อไป (demo-only)
# ค่า fallback ใน src/app/api/[...path]/route.ts คือ http://localhost:3002; Docker Compose ตั้งเป็น http://api:3001
API_INTERNAL_URL=http://localhost:3002
# Optional Martin origin for the /tiles proxy. Use TILES_PORT=3202 in Compose when running the host API on 3002.
# TILES_INTERNAL_URL=http://127.0.0.1:3202
