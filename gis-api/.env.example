# ค่าสาธิตสำหรับ host development; Docker ใช้ environment จาก Compose
DATABASE_URL=postgresql://gis:gis-local-demo-only@localhost:54329/gis
PORT=3002
SEED_DATA_DIR=../gis-docs/seed-data
IMPORT_REPORT_DIR=../gis-docs/reports
JWT_SECRET=local-demo-only-jwt-secret-not-for-production
PUBLIC_WEB_ORIGIN=http://localhost:3003
API_DOCS_ORIGIN=http://localhost:3002
# เปิดเฉพาะ local demo; ปิด (false) สำหรับใช้งานจริง
DEMO_LOGIN_ENABLED=false
DEMO_VIEWER_PASSWORD=viewer-demo-only
DEMO_EDITOR_PASSWORD=editor-demo-only
DEMO_ADMIN_PASSWORD=admin-demo-only
